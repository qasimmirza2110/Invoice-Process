# Copy to .env.local in the React project (never commit .env.local).
# These are PUBLIC configuration values, not secrets. Never put a password, token, API key or database URL in a
# Vite variable: everything named VITE_* is compiled into the JavaScript bundle that every visitor can read.

# Dev-server proxy target (read only by vite.config.ts, NOT exposed to the browser).
# Render service: https://invoice-process.onrender.com    Local backend: http://127.0.0.1:8088
API_PROXY_TARGET=https://invoice-process.onrender.com

# Prefix for API calls made by the browser code. Keep it EMPTY in development: calls go to "/api/..." on the dev
# server, which forwards them (works today; no CORS involved).
# Only if the app runs on another origin AND the backend owner has added that exact origin (for example
# http://localhost:5173 or the real frontend URL) to INVOICE_CORS_ALLOWED_ORIGINS, use instead:
#   VITE_API_BASE_URL=https://invoice-process.onrender.com
# On 2026-10-28 no origin was allowed on the Render service, so direct calls fail with a CORS error.
VITE_API_BASE_URL=
