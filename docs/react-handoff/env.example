# Copy to .env.local in the React project (never commit .env.local).
# These are PUBLIC configuration values, not secrets. Never put a password, token, API key or database URL in a
# Vite variable: everything named VITE_* is compiled into the JavaScript bundle that every visitor can read.

# Dev-server proxy target (read only by vite.config.ts, NOT exposed to the browser). The exact URL comes from the
# handoff package's verification report; do not guess it.
API_PROXY_TARGET=https://YOUR-ACTUAL-SERVICE.onrender.com

# Prefix for API calls made by the browser code. Keep it EMPTY in development: calls go to "/api/..." on the dev
# server, which forwards them. Set it to the API's public URL only if the app is hosted on another origin AND the
# backend owner has added that exact origin to INVOICE_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
