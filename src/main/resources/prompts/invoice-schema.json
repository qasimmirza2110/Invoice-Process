{
  "type": "object",
  "properties": {
    "invoiceNumber": { "type": ["string", "null"] },
    "invoiceDate":   { "type": ["string", "null"], "description": "Invoice date in YYYY-MM-DD format" },
    "sellerName":    { "type": ["string", "null"] },
    "sellerTaxId":   { "type": ["string", "null"] },
    "buyerName":     { "type": ["string", "null"] },
    "buyerTaxId":    { "type": ["string", "null"] },
    "currency":      { "type": ["string", "null"], "description": "3-letter ISO 4217 currency code" },
    "subtotal":      { "type": ["number", "null"], "description": "Printed subtotal of the product line items, before invoice-level discount, shipping and tax" },
    "discountAmount": { "type": ["number", "null"], "description": "Invoice-level discount as a positive number, even if printed with a minus sign; null if no discount is printed" },
    "shippingAmount": { "type": ["number", "null"], "description": "Shipping, handling or delivery charge; null if none is printed" },
    "taxAmount":     { "type": ["number", "null"] },
    "totalAmount":   { "type": ["number", "null"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": ["string", "null"] },
          "quantity":    { "type": ["number", "null"] },
          "unitPrice":   { "type": ["number", "null"] },
          "taxRate":     { "type": ["number", "null"], "description": "Tax rate as a percentage, e.g. 18 for 18%" },
          "lineTotal":   { "type": ["number", "null"] }
        },
        "required": ["description", "quantity", "unitPrice", "taxRate", "lineTotal"]
      }
    }
  },
  "required": ["invoiceNumber", "invoiceDate", "sellerName", "sellerTaxId", "buyerName", "buyerTaxId",
               "currency", "subtotal", "discountAmount", "shippingAmount", "taxAmount", "totalAmount", "items"]
}
