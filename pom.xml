<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.actify</groupId>
	<artifactId>actify-invoice-process</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Actify Invoice Process</name>
	<description>API-only backend: invoice PDF -> Gemini -> JSON -> Java validation -> human review -> PostgreSQL</description>

	<properties>
		<java.version>1.8</java.version>
		<!-- Only JDK 17 is installed on this machine. "release 8" makes javac reject
		     anything that is not valid Java 8 (language features AND JDK APIs). -->
		<maven.compiler.release>8</maven.compiler.release>
		<pgtest.excludedGroups>pgtest</pgtest.excludedGroups>
		<!-- Spring Security 5.7.x (managed by Boot 2.7.18) pulls in nimbus-jose-jwt 9.22, which is affected by
		     CVE-2025-53864 (deeply nested JSON claims -> denial of service) and CVE-2023-52428.
		     9.37.4 is the patched release of the same 9.x line (Apache-2.0, Java 7+ bytecode).
		     Compatibility is proven by JwtCompatibilitySpikeTest. -->
		<nimbus-jose-jwt.version>9.37.4</nimbus-jose-jwt.version>
		<!-- AWS SDK for Java 2.x (Apache-2.0, Java 8+), used only as the S3 client for the private document bucket
		     (Neon Object Storage). 2.55.16 was released 2026-10-13. -->
		<aws-sdk.version>2.55.16</aws-sdk.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.nimbusds</groupId>
				<artifactId>nimbus-jose-jwt</artifactId>
				<version>${nimbus-jose-jwt.version}</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Upload check: an accepted file must really open as a PDF (PdfFiles), not just start with "%PDF-".
		     Apache-2.0, Java 8+. commons-logging is replaced by Spring's spring-jcl, which provides the same API. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
			<exclusions>
				<exclusion>
					<groupId>commons-logging</groupId>
					<artifactId>commons-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Original PDFs in a private S3-compatible bucket (S3DocumentStorage). Only the JDK's own HTTP client is used:
		     the default Apache and Netty clients are excluded to keep the JAR and the dependency tree small. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<exclusions>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache5-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>
		<!-- Login, password hashing (BCrypt), Bearer-token authentication and URL/role rules. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Spring Security's JWT support (NimbusJwtEncoder / NimbusJwtDecoder). We are our own token
		     issuer: tokens are HS256-signed with INVOICE_JWT_SECRET; no external identity provider. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Tests tagged "pgtest" need the separate PostgreSQL test database. They are skipped by
				     default, so a plain "mvnw test" never needs or touches any database. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>${pgtest.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- mvnw test -Ppgtest : also runs the PostgreSQL integration tests against
		     Actify-Internship-Invoice-Process_test_db (never the live database;
		     PgTestDatabaseGuard refuses to start otherwise). -->
		<profile>
			<id>pgtest</id>
			<properties>
				<pgtest.excludedGroups>no-excluded-tags</pgtest.excludedGroups>
			</properties>
		</profile>
	</profiles>

</project>
