# NAMES ONLY. Spring Boot does NOT read a .env file (no dotenv library, no spring.config.import). Put the values in the
# Eclipse run configuration -> Environment tab (or the OS environment of the process). A .env file has no effect.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Your project's limits from Google AI Studio, as WHOLE numbers (250000, not 250k). No defaults on purpose.
GEMINI_LIMIT_RPM=
GEMINI_LIMIT_TPM=
GEMINI_LIMIT_RPD=
GEMINI_INITIAL_TOKEN_ESTIMATE=

# Local demo: Gemini stays OFF unless ALL of these are set deliberately (SchemaSafetyGuard enforces it).
# INVOICE_WORKER_ONLY_INVOICE_IDS limits the worker to named invoices so the queued backlog is never processed.
INVOICE_LOCALDEMO_GEMINI_ENABLED=false
INVOICE_WORKER_ENABLED=false
INVOICE_WORKER_ONLY_INVOICE_IDS=

# Google Drive / OneDrive pickers - names only. Set real values in the Eclipse launch environment, never in Git.
# All of these are public browser values (no client secret exists); restrict them at the provider.
# Setup: docs/PROVIDER_SETUP_GOOGLE_DRIVE_ONEDRIVE.md
INVOICE_GOOGLE_CLIENT_ID=
INVOICE_GOOGLE_API_KEY=
INVOICE_GOOGLE_APP_ID=
INVOICE_GOOGLE_LIVE_TESTED=false
# PERSONAL or WORK_OR_SCHOOL - the owner's decision
INVOICE_ONEDRIVE_ACCOUNT_TYPE=
INVOICE_ONEDRIVE_CLIENT_ID=
INVOICE_ONEDRIVE_TENANT_ID=
INVOICE_ONEDRIVE_SHAREPOINT_BASE_URL=
INVOICE_ONEDRIVE_LIVE_TESTED=false
